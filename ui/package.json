{
  "name": "supernexus-ui",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:renderer": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && tsc -p apps/main/tsconfig.json && tsc -p apps/preload/tsconfig.json && cross-env NODE_ENV=development electron dist/main/main.js\"",
    "build": "tsc && vite build",
    "build:main": "tsc -p apps/main/tsconfig.json",
    "build:preload": "tsc -p apps/preload/tsconfig.json",
    "build:main:tsc": "tsc -p apps/main/tsconfig.json",
    "build:preload:tsc": "tsc -p apps/preload/tsconfig.json",
    "build:electron": "vite build && npm run build:main:tsc && npm run build:preload:tsc",
    "dist": "npm run build:electron && electron-builder",
    "dist:dir": "npm run build:electron && electron-builder --dir",
    "dist:win": "npm run build:electron && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "build": {
    "appId": "ai.supernexus.desktop",
    "productName": "SuperNEXUS v2",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": ["api/**/*", "core/**/*", "bridges/**/*", "services/**/*", "agents/**/*", "memory/**/*", "brain/**/*", "tools/**/*", "skills/**/*", "security/**/*", "optimization/**/*", "observability/**/*", "integrations/**/*", "control/**/*", "config/**/*", "cli/**/*", "plugins/**/*", "evaluation/**/*", "gemas/**/*", "gemas_core/**/*", "codegraph/**/*", "improvements/**/*", "legacy/**/*", "programs/**/*", "research/**/*", "app/**/*", "setup/**/*", "setup.py"]
      },
      {
        "from": "../brain",
        "to": "brain"
      },
      {
        "from": "../data",
        "to": "data"
      },
      {
        "from": "../memory",
        "to": "memory"
      },
      {
        "from": "../models",
        "to": "models"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../hive_agents.json",
        "to": "hive_agents.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "SuperNEXUS-v2-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SuperNEXUS v2",
      "installerIcon": "public/icon.ico",
      "uninstallDisplayName": "SuperNEXUS v2"
    },
    "extraMetadata": {
      "main": "dist/main/main.js"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.0",
    "vite": "^7.0.4",
    "wait-on": "^8.0.1"
  }
}
