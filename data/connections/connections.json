{
  "version": "1",
  "description": "Single source of truth for all connected programs/agents. Add one entry per connection and the system handles the rest.",
  "defaults": {
    "timeout_s": 120,
    "health_check_interval_s": 30
  },
  "connections": [
    {
      "name": "director",
      "label": "NEXUS Director",
      "description": "Cerebro central del ecosistema",
      "type": "api",
      "protocol": "http",
      "url": "http://localhost:9000/api/chat",
      "method": "POST",
      "headers": { "Content-Type": "application/json" },
      "body_template": "{\"message\":\"{task}\"}",
      "response_parser": "jsonpath:$.reply",
      "timeout_s": 120,
      "tags": ["orchestrator", "nexus", "core"],
      "enabled": true,
      "autonomous": false,
      "health_check": { "type": "http", "endpoint": "http://localhost:9000/api/status", "expected": "online" }
    },
    {
      "name": "claude",
      "label": "Claude Code",
      "description": "Anthropic Claude Sonnet 4.5 CLI",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "claude",
      "args": ["-p", "--model", "claude-sonnet-4-5", "{task}"],
      "timeout_s": 180,
      "tags": ["reasoning", "code", "anthropic"],
      "enabled": false,
      "autonomous": false,
      "health_check": { "type": "binary", "endpoint": "claude" }
    },
    {
      "name": "hermes",
      "label": "Hermes Agent",
      "description": "Self-improving open source AI agent (Nous Research)",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "hermes",
      "args": ["chat", "-Q", "-q", "{task}"],
      "cwd": ".",
      "timeout_s": 120,
      "tags": ["orchestration", "browser", "autonomous"],
      "enabled": true,
      "autonomous": false,
      "health_check": { "type": "binary", "endpoint": "hermes" }
    },
    {
      "name": "opencode",
      "label": "OpenCode (MiniMax M3)",
      "description": "OpenCode free tier: MiniMax M3",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "opencode",
      "args": ["run", "-m", "opencode/minimax-m3-free", "{task}"],
      "cwd": ".",
      "timeout_s": 180,
      "tags": ["reasoning", "opencode", "free"],
      "enabled": true,
      "autonomous": false,
      "health_check": { "type": "binary", "endpoint": "opencode-cli.cmd" }
    },
    {
      "name": "oc-deepseek",
      "label": "OpenCode (DeepSeek V4)",
      "description": "OpenCode free tier: DeepSeek V4 Flash",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "opencode",
      "args": ["run", "-m", "opencode/deepseek-v4-flash-free", "{task}"],
      "cwd": ".",
      "timeout_s": 180,
      "tags": ["reasoning", "opencode", "free"],
      "enabled": true,
      "autonomous": false,
      "health_check": { "type": "binary", "endpoint": "opencode-cli.cmd" }
    },
    {
      "name": "oc-mimo",
      "label": "OpenCode (MiMo V2.5)",
      "description": "OpenCode free tier: MiMo V2.5",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "opencode",
      "args": ["run", "-m", "opencode/mimo-v2.5-free", "{task}"],
      "cwd": ".",
      "timeout_s": 180,
      "tags": ["fast", "opencode", "free"],
      "enabled": true,
      "autonomous": false
    },
    {
      "name": "oc-nemotron",
      "label": "OpenCode (Nemotron 3)",
      "description": "OpenCode free tier: Nemotron 3 Super",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "opencode",
      "args": ["run", "-m", "opencode/nemotron-3-super-free", "{task}"],
      "cwd": ".",
      "timeout_s": 180,
      "tags": ["reasoning", "opencode", "free"],
      "enabled": true,
      "autonomous": false
    },
    {
      "name": "oc-bigpickle",
      "label": "OpenCode (Big Pickle)",
      "description": "OpenCode free tier: Big Pickle",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "opencode",
      "args": ["run", "-m", "opencode/big-pickle", "{task}"],
      "cwd": ".",
      "timeout_s": 180,
      "tags": ["experimental", "opencode", "free"],
      "enabled": true,
      "autonomous": false
    },
    {
      "name": "openclaw",
      "label": "OpenClaw Tray MCP",
      "description": "OpenClaw Tray MCP (JSON-RPC, system tools)",
      "type": "mcp",
      "protocol": "http",
      "url": "http://127.0.0.1:8765/",
      "headers": { "Authorization": "Bearer 8RjHqMKfgwKgPWRFj4bhJGd45jIMCzKyE8yvoOcPUuo" },
      "default_tool": "system.run",
      "timeout_s": 120,
      "tags": ["orchestration", "mcp", "windows"],
      "enabled": true,
      "autonomous": false
    },
    {
      "name": "antigravity",
      "label": "Antigravity (Gemini)",
      "description": "Google Gemini via file-mailbox bridge",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "python",
      "args": ["hive_runner_bridge.py"],
      "stdin_json": true,
      "env": {
        "ANTIGRAVITY_APP_DATA": "~/.gemini/antigravity"
      },
      "response_parser": "antigravity_bridge",
      "timeout_s": 200,
      "tags": ["reasoning", "google", "gemini"],
      "enabled": true,
      "autonomous": false
    },
    {
      "name": "agent-zero",
      "label": "Agent Zero",
      "description": "Agent Zero Docker (sandboxed Python)",
      "type": "api",
      "protocol": "http",
      "url": "http://localhost:50080/api/api_message",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "X-API-KEY": "EnOpxcoaJDw7K0TW"
      },
      "body_template": "{\"message\":\"{task}\"}",
      "response_parser": "jsonpath:$.response",
      "timeout_s": 120,
      "tags": ["sandbox", "docker", "code-exec"],
      "enabled": true,
      "autonomous": false,
      "health_check": { "type": "http", "endpoint": "http://localhost:50080/api/status" }
    },
    {
      "name": "pc2",
      "label": "PC2 Remoto",
      "description": "PC2 node via SSH (configure IP in env)",
      "type": "cli",
      "protocol": "subprocess",
      "binary": "ssh",
      "args": ["-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=no", "user@PC2_IP", "{task}"],
      "timeout_s": 90,
      "tags": ["remote", "gpu", "linux"],
      "enabled": false,
      "autonomous": false,
      "health_check": { "type": "shell", "endpoint": "ssh -o ConnectTimeout=3 user@PC2_IP echo ok" }
    },
    {
      "name": "zero-code",
      "label": "Zero Code (autonomous loop)",
      "description": "Autonomous listener on Agent Zero Docker",
      "type": "autonomous_loop",
      "protocol": "messageboard",
      "script": "src/agents/zero_autonomous_loop.py",
      "tags": ["sandbox", "docker", "autonomous"],
      "enabled": true,
      "auto_start": false
    },
    {
      "name": "hermes-code",
      "label": "Hermes Code (autonomous loop)",
      "description": "Autonomous listener on Hermes Agent CLI",
      "type": "autonomous_loop",
      "protocol": "messageboard",
      "script": "src/agents/hermes_autonomous_loop.py",
      "tags": ["orchestration", "browser", "autonomous"],
      "enabled": true,
      "auto_start": false
    },
    {
      "name": "aider-code",
      "label": "Aider Code (autonomous loop)",
      "description": "Autonomous listener on Aider CLI",
      "type": "autonomous_loop",
      "protocol": "messageboard",
      "script": "src/agents/aider_autonomous_loop.py",
      "tags": ["pair-programming", "autonomous"],
      "enabled": true,
      "auto_start": false
    },
    {
      "name": "qwen-code",
      "label": "Qwen Code (autonomous loop)",
      "description": "Autonomous listener on Qwen CLI",
      "type": "autonomous_loop",
      "protocol": "messageboard",
      "script": "src/agents/qwen_autonomous_loop.py",
      "tags": ["coding", "autonomous"],
      "enabled": true,
      "auto_start": false
    },
    {
      "name": "supernexus",
      "label": "SuperNEXUS (autonomous loop)",
      "description": "Autonomous listener with local Ollama",
      "type": "autonomous_loop",
      "protocol": "messageboard",
      "script": "src/agents/nexus_autonomous_loop.py",
      "tags": ["local", "ollama", "autonomous"],
      "enabled": true,
      "auto_start": false
    }
  ]
}
