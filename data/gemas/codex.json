{
  "name": "codex",
  "version": "2.0.0",
  "description": "Ejecutor de codigo en sandboxes locales y compilacion",
  "main": "src.agents.codex_gem",
  "model": "gemma4:12b",
  "activationEvents": [
    "onCommand:codex",
    "onCommand:compile",
    "onCommand:sandbox"
