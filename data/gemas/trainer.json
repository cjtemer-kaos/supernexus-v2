{
  "name": "trainer",
  "version": "2.0.0",
  "description": "Generador de manuales, guias y tutoriales interactivos",
  "main": "src.agents.trainer_gem",
  "model": "deepseek-v4-flash-free",
  "activationEvents": [
    "onCommand:teach",
    "onCommand:train",
    "onCommand:guide"
  ],
  "semanticKeywords": [
    "teach",
    "train",
    "tutorial",
    "guide",
    "manual",
    "learn",
    "education",
    "course",
    "explain",
    "basics",
    "lesson"
  ],
  "category": "content",
  "maxMemoryMB": 256,
  "maxCPUPercent": 15,
  "timeoutSeconds": 180,
  "autoRestart": true,
  "maxRestarts": 5,
  "parallelCapable": true
}