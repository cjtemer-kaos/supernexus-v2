# SuperNEXUS v2 — Configuracion de Entorno
# Copia este archivo a .env y completa con tus valores

# Directorio del proyecto
NEXUS_PROJECT_DIR=${HOME}/supernexus-v2

# Puerto del API
NEXUS_PORT=9400

# URL completa para la UI
VITE_NEXUS_URL=http://localhost:9400

# Ollama
OLLAMA_URL=http://localhost:11434

# API KEYS (Opcionales)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# OpenCode Zen (modelos cloud gratuitos)
# Obtener key en: https://opencode.ai/auth
OPENCODE_API_KEY=

# Brave Search (para busqueda web via MCP)
# Obtener key en: https://brave.com/search/api/
BRAVE_API_KEY=

# GitHub Personal Access Token
# Obtener en: GitHub Settings → Developer Settings → Personal Access Tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Nodo remoto (opcional)
REMOTE_NODE_IP=
REMOTE_NODE_PORT=22
REMOTE_NODE_USER=

# Logging
NEXUS_LOG_LEVEL=INFO

# Directorio del cerebro (NEXUS_BRAIN)
# Por defecto: ${NEXUS_PROJECT_DIR}/brain
NEXUS_BRAIN=${NEXUS_PROJECT_DIR}/brain
